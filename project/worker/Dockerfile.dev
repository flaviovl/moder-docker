# syntax=docker/dockerfile:1
# Base de build do worker nos dois Dockerfiles (Dockerfile e Dockerfile.dev): golang:1.27.4.

FROM golang:1.27.4
WORKDIR /src
# Sem cache mount aqui: os módulos precisam ficar na imagem, porque go run e go test rodam no contêiner.
COPY go.mod go.sum ./
RUN go mod download
COPY . .
CMD ["go", "run", "."]
