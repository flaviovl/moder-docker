# syntax=docker/dockerfile:1
# Base do frontend nos três Dockerfiles (Dockerfile, Dockerfile.dev e Dockerfile.test): node:26.13.1-slim.

FROM node:26.13.1-slim
ENV PNPM_HOME=/pnpm NEXT_TELEMETRY_DISABLED=1
RUN npm install -g pnpm@12.21.0
WORKDIR /app
COPY package.json pnpm-lock.yaml ./
RUN --mount=type=cache,target=/pnpm/store,id=pnpm-store pnpm install --frozen-lockfile
COPY . .
# O typegen gera os tipos de rota do Next, que o tsc precisa para checar o projeto.
CMD ["sh", "-c", "pnpm lint && pnpm exec next typegen && pnpm exec tsc --noEmit"]
